OPENAI_API_KEY=your-openai-api-key-here

# Default Model for all Agents
OPENAI_MODEL=gpt-4o

# Per-Agent Model Configurations (Optional Overrides)
DEMAND_AGENT_MODEL=gpt-4o
INTRO_AGENT_MODEL=gpt-4o
STRUCTURE_AGENT_MODEL=gpt-4o
CONCLUSION_AGENT_MODEL=gpt-4o
FACT_AGENT_MODEL=gpt-4o
MASTER_ARBITER_MODEL=gpt-4o
VISION_AGENT_MODEL=gpt-4o

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Langfuse Observability (Optional - Leave blank to disable)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development


# Supabase Cloud Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_STORAGE_BUCKET=

# Frontend Backend API Configuration
VITE_API_BASE_URL=https://answer-writing-evaluation.onrender.com
